# ============================================================
#  .env.example — Environment variables template
#
#  IMPORTANT:
#   1. Copy this file and rename it to just: .env
#   2. Fill in your real API keys and passwords
#   3. NEVER upload your .env file to GitHub!
#      It is already listed in .gitignore for safety.
# ============================================================

# ── PostgreSQL Database ──
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/socialpulse

# ── Redis Cache ──
REDIS_URL=redis://localhost:6379

# ── Meta Graph API (Instagram + Facebook) ──
# Get from: https://developers.facebook.com/
META_ACCESS_TOKEN=your_meta_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_user_id
FACEBOOK_PAGE_ID=your_facebook_page_id

# ── LinkedIn API ──
# Get from: https://www.linkedin.com/developers/
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_ORG_ID=your_linkedin_organization_id

# ── YouTube Data API v3 ──
# Get from: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# ── TikTok Research API ──
# Apply at: https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_USERNAME=your_tiktok_username
